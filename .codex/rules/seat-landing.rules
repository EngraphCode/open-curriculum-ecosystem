# Exec-policy rules for Codex team seats in this repository: the landing path
# (commit, push through the merge bot, open a pull request) runs with no
# approval prompt, as the owner requires: "I absolutely need all seats to be
# able to push without me" (2026-09-25).
#
# Why rules and not a writable root: workspace-write keeps `.git` read-only, and
# in a linked worktree the git dir sits outside every writable root, so no git
# write succeeds inside the sandbox. Making `.git` writable would let sandboxed
# code plant hooks that later run outside it. An allowed command below instead
# skips approval and runs outside the sandbox, and only when every segment of
# the command matches an allowed rule. So each rule allows the narrowest prefix
# that does the job, and seats run each as one plain command (see README.md).
#
# Codex loads these rules only for a trusted project, at session start. Codex
# checks every `match` and `not_match` example when it loads the file; a file
# that fails to parse drops every user and project rule.

prefix_rule(
    pattern = ["pnpm", "agent-tools", "merge-bot", "push"],
    decision = "allow",
    justification = "Seats push only through the merge bot, which refuses force, --no-verify, unknown flags and default branches.",
    match = [
        ["pnpm", "agent-tools", "merge-bot", "push", "--branch", "feat/example"],
    ],
    not_match = [
        ["pnpm", "agent-tools", "merge-bot", "merge", "--pr", "1"],
        ["git", "push", "origin", "feat/example"],
    ],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Staging writes the git index, which the sandbox keeps read-only.",
    match = [
        ["git", "add", "--", "README.md"],
    ],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "A commit writes the git dir and runs the repository's hooks, the quality gates.",
    match = [
        ["git", "commit", "-F", "message.txt"],
    ],
)

prefix_rule(
    pattern = ["git", "fetch"],
    decision = "allow",
    justification = "Fetching the base before a sync or a new worktree writes the git dir.",
    match = [
        ["git", "fetch", "origin", "engraph"],
    ],
)

prefix_rule(
    pattern = ["git", "merge"],
    decision = "allow",
    justification = "A pull request syncs with its base by a merge, never a rebase.",
    match = [
        ["git", "merge", "--no-edit", "origin/engraph"],
    ],
)

prefix_rule(
    pattern = ["git", "worktree", "add"],
    decision = "allow",
    justification = "Implementation work starts in a fresh worktree, never on the primary checkout.",
    match = [
        ["git", "worktree", "add", "-b", "feat/example", "../example", "origin/engraph"],
    ],
    not_match = [
        ["git", "worktree", "remove", "../example"],
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "allow",
    justification = "Opening the pull request, with the bot token from the environment.",
    match = [
        ["gh", "pr", "create", "--draft", "--base", "engraph"],
    ],
    not_match = [
        ["gh", "pr", "merge", "1"],
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Push with `pnpm agent-tools merge-bot push --branch <branch>`, which refuses force and default branches.",
    match = [
        ["git", "push", "origin", "feat/example"],
        ["git", "push", "--force", "origin", "feat/example"],
    ],
)
