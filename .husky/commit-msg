#!/usr/bin/env sh

# Check for breaking changes first, we want to block accidental major version bumps
pnpm agent-tools:prevent-accidental-major-version "$1" || exit 1

# Then run commitlint from the repo-pinned dependency graph. Strict mode: a
# warning fails the commit (exit 2) as an error does (exit 3). A warning that
# passes is a warning that ships (no-warning-toleration).
pnpm exec commitlint --strict --edit "$1"
